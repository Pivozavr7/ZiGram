{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "edit": {
      "*": "ask",
      "src/**": "allow",
      "tests/**": "allow",
      "build.zig": "ask",
      "build.zig.zon": "ask",
      "scripts/**": "ask",
      "AGENTS.md": "ask",
      "opencode.json": "deny",
      ".git/**": "deny",
      "vendor/**": "deny",
      "**/*.local.zon": "deny",
      "**/.env*": "deny"
    },
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.local.zon": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_*": "deny",
      "**/secrets/**": "deny",
      "vendor/tdlib/**": "deny",
      ".zig-cache/**": "deny",
      "zig-out/**": "deny"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "zig version": "allow",
      "zig fmt *": "allow",
      "zig ast-check *": "allow",
      "zig build": "allow",
      "zig build test": "allow",
      "zig build test *": "allow",
      "zig build --summary *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout*": "deny",
      "git rebase*": "deny",
      "git config*": "deny",
      "rm*": "deny",
      "mv /*": "deny",
      "sudo*": "deny",
      "doas*": "deny",
      "su *": "deny",
      "pacman*": "deny",
      "paru*": "deny",
      "yay*": "deny",
      "chmod*": "deny",
      "chown*": "deny",
      "dd*": "deny",
      "mkfs*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "ssh*": "deny",
      "scp*": "deny",
      "env": "deny",
      "printenv*": "deny"
    },
    "webfetch": "ask",
    "external_directory": "deny",
    "doom_loop": "ask"
  }
}
